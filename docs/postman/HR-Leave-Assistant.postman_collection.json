{
  "info": {
    "name": "HR Leave Assistant",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Start the app with ./mvnw spring-boot:run, then run the requests. baseUrl is http://localhost:8080."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "requestId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "1. Basics",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            }
          }
        },
        {
          "name": "Balances",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/balances",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "balances"
              ]
            },
            "description": "Allowance, used and remaining days per leave type."
          }
        }
      ]
    },
    {
      "name": "2. Happy path (run in order)",
      "item": [
        {
          "name": "Create request (Mon 7 to Fri 11 Dec)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/leave-requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "leave-requests"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"leaveType\": \"ANNUAL\",\n  \"startDate\": \"2026-12-07\",\n  \"endDate\": \"2026-12-11\",\n  \"reason\": \"trip\"\n}"
            },
            "description": "Saves the new id in the requestId variable. Expect 201, status PENDING, workingDays 5."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.id) { pm.collectionVariables.set('requestId', body.id); }",
                  "pm.test('status is 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "List requests",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/leave-requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "leave-requests"
              ]
            }
          }
        },
        {
          "name": "Get request",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/leave-requests/{{requestId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "leave-requests",
                "{{requestId}}"
              ]
            }
          }
        },
        {
          "name": "Approve",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/leave-requests/{{requestId}}/approve",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "leave-requests",
                "{{requestId}}",
                "approve"
              ]
            }
          }
        },
        {
          "name": "History",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/leave-requests/{{requestId}}/history",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "leave-requests",
                "{{requestId}}",
                "history"
              ]
            },
            "description": "First event has fromStatus null."
          }
        },
        {
          "name": "Cancel",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/leave-requests/{{requestId}}/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "leave-requests",
                "{{requestId}}",
                "cancel"
              ]
            },
            "description": "Approved leave can only be cancelled before its start date. December 2026 is in the future, so this works until then."
          }
        },
        {
          "name": "Reject (use on a PENDING request)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/leave-requests/{{requestId}}/reject",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "leave-requests",
                "{{requestId}}",
                "reject"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Errors to try",
      "item": [
        {
          "name": "409 Overlap (create Dec 7-11 first)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/leave-requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "leave-requests"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"leaveType\": \"ANNUAL\",\n  \"startDate\": \"2026-12-09\",\n  \"endDate\": \"2026-12-15\",\n  \"reason\": \"trip\"\n}"
            }
          }
        },
        {
          "name": "409 Not enough balance",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/leave-requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "leave-requests"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"leaveType\": \"ANNUAL\",\n  \"startDate\": \"2026-12-01\",\n  \"endDate\": \"2027-01-29\",\n  \"reason\": \"trip\"\n}"
            }
          }
        },
        {
          "name": "409 Weekend only (no working days)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/leave-requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "leave-requests"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"leaveType\": \"ANNUAL\",\n  \"startDate\": \"2026-12-05\",\n  \"endDate\": \"2026-12-06\",\n  \"reason\": \"trip\"\n}"
            }
          }
        },
        {
          "name": "400 Missing startDate",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/leave-requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "leave-requests"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"leaveType\": \"ANNUAL\",\n  \"endDate\": \"2026-12-11\"\n}"
            }
          }
        },
        {
          "name": "400 Start after end",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/leave-requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "leave-requests"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"leaveType\": \"ANNUAL\",\n  \"startDate\": \"2026-12-11\",\n  \"endDate\": \"2026-12-07\",\n  \"reason\": \"trip\"\n}"
            }
          }
        },
        {
          "name": "400 Invalid date",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/leave-requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "leave-requests"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"leaveType\": \"ANNUAL\",\n  \"startDate\": \"not-a-date\",\n  \"endDate\": \"2026-12-07\",\n  \"reason\": \"trip\"\n}"
            }
          }
        },
        {
          "name": "404 Unknown id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/leave-requests/999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "leave-requests",
                "999999"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Policy assistant (needs Ollama running)",
      "item": [
        {
          "name": "Ingest the policy (safe to repeat)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/policy/ingest",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "policy",
                "ingest"
              ]
            },
            "description": "First call returns INGESTED; repeating it returns UNCHANGED."
          }
        },
        {
          "name": "Search: cancel approved leave",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/policy/search?q=can%20I%20cancel%20approved%20leave&topK=4",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "policy",
                "search"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "can%20I%20cancel%20approved%20leave"
                },
                {
                  "key": "topK",
                  "value": "4"
                }
              ]
            }
          }
        },
        {
          "name": "Search: vacation days",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/policy/search?q=how%20many%20vacation%20days%20do%20I%20get",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "policy",
                "search"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "how%20many%20vacation%20days%20do%20I%20get"
                }
              ]
            }
          }
        },
        {
          "name": "Search: unused days",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/policy/search?q=what%20happens%20to%20days%20I%20did%20not%20use",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "policy",
                "search"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "what%20happens%20to%20days%20I%20did%20not%20use"
                }
              ]
            }
          }
        },
        {
          "name": "Search: no answer (parental leave) -> []",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/policy/search?q=what%20is%20the%20parental%20leave",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "policy",
                "search"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "what%20is%20the%20parental%20leave"
                }
              ]
            }
          }
        },
        {
          "name": "Search: no answer (work from home) -> []",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/policy/search?q=can%20I%20work%20from%20home",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "policy",
                "search"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "can%20I%20work%20from%20home"
                }
              ]
            }
          }
        },
        {
          "name": "Answer (streamed): cancel approved leave",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/policy/answer?q=can%20I%20cancel%20approved%20leave",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "policy",
                "answer"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "can%20I%20cancel%20approved%20leave"
                }
              ]
            },
            "description": "Server-sent events. Postman desktop shows the events as they arrive; in the web client or a browser you may only see the end. With curl use: curl -N \"localhost:8080/api/policy/answer?q=...\""
          }
        },
        {
          "name": "Answer (streamed): no answer -> fixed refusal",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/policy/answer?q=what%20is%20the%20parental%20leave",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "policy",
                "answer"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "what%20is%20the%20parental%20leave"
                }
              ]
            }
          }
        },
        {
          "name": "400 Blank question",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/policy/search?q=%20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "policy",
                "search"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "%20"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}